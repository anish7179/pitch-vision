# ============================================
# PitchVision Server — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# --- Server ---
NODE_ENV=development
PORT=5000

# --- MongoDB Atlas ---
# Get your connection string from: https://cloud.mongodb.com
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/pitchvision?retryWrites=true&w=majority

# --- Google OAuth 2.0 ---
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# --- JWT Secrets ---
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_64_byte_hex_string
JWT_REFRESH_SECRET=replace_with_a_different_64_byte_hex_string

# --- Frontend URL (for CORS and OAuth redirect) ---
CLIENT_URL=http://localhost:5173

# --- API-Football (api-sports.io) ---
# Register at: https://www.api-sports.io/ (free tier = 100 requests/day)
API_FOOTBALL_KEY=your_api_football_key_here
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# --- Rate Limiter ---
# Hard ceiling for daily API-Football calls (reserve 10 for live polling)
API_FOOTBALL_DAILY_LIMIT=90

# --- Redis Cache (Phase 2) ---
# Optional — server degrades gracefully if Redis is unavailable.
# Default: redis://127.0.0.1:6379
REDIS_URL=redis://127.0.0.1:6379
